#include <stdio.h>

int main() {
    char word[] = "yellow";
    char result[4];  // 3 буквы + 1 символ '\0'
    int start = 3;   // 'l' — четвертый символ, индекс 3
    int end = 6;     // после 'w' — индекс 6
    int j = 0;

    for (int i = start; i < end; i++) {
        result[j++] = word[i];
    }
    result[j] = '\0';  // завершение строки

    printf("Подстрока: %s\n", result);

    return 0;
}
